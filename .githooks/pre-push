#!/usr/bin/env bash
set -Eeuo pipefail

REPO="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$REPO"

source "$REPO/tools/lib.sh"
require_bash 4.4 "$REPO/.githooks/pre-push" "$@"
shopt -s inherit_errexit

[[ -x "$REPO/tools/verify.sh" ]] ||
	die "tools/verify.sh is missing or not executable; run: tools/install-hooks.sh"

on_failure() {
	local status=$?
	[[ "$status" -eq 0 ]] && exit 0
	say FAILED "pre-push checks failed, nothing was pushed"
	say INFO "run the same gate directly with: tools/verify.sh"
	exit "$status"
}
trap on_failure EXIT

if [[ -x "$REPO/tools/reinstall.sh" ]]; then
	say INFO "pruning stale build data from target/"
	"$REPO/tools/reinstall.sh" --prune-only ||
		say WARNING "the build cache prune did not finish; the gate still runs"
fi

say INFO "running the pre-push verification gate"
"$REPO/tools/verify.sh"
say SUCCESS "pre-push checks passed"
