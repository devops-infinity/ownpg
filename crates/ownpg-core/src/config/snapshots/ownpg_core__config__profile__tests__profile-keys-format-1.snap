---
source: crates/ownpg-core/src/config/profile.rs
expression: "keys.join(\"\\n\")"
---
format 1
profile: application_name, audit, audit_keep_files, audit_max_bytes, audit_path, byte_cap, channel_binding, connect_timeout_seconds, cursor_expiry_seconds, database, dsn, handle_expiry_seconds, host, hostaddr, http, lock_timeout_seconds, mode, no_input, options, output_dir, password, password_env, password_keychain, pg_bindir, pooled, port, row_cap, schema, service, ssh, sslcert, sslkey, sslmode, sslrootcert, statement_timeout_seconds, strict_role, tools, transaction_timeout_seconds, user
ssh: agent, config_file, connect_timeout_seconds, host, jump, key_file, known_hosts, passphrase_keychain, password_env, port, transport, trust_new_host, user
http: allowed_hosts, allowed_origins, auth, bind, body_cap_bytes, max_connections, oauth_audience, oauth_issuer, oauth_jwks_url, older_client_sessions, otel_endpoint, pool_size, public_url, rate_limit_per_minute, shutdown_seconds, state_key_file, tokens_file, trusted_proxies
