        },
        "row_count": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "rows": {
          "items": {
            "items": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Cell"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": "array"
          },
          "type": "array"
        },
        "rows_affected": {
