  {
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "close": {
          "default": false,
          "description": "With a cursor, true closes it instead of reading the next page and releases its connection.",
          "type": "boolean"
        },
        "cursor": {
          "default": "",
          "description": "Cursor from a previous truncated result. Leave empty to run sql.",
          "type": "string"
        },
        "row_cap": {
          "default": 0,
          "description": "Rows per page. 0 uses the configured default (100). The maximum is 1000.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "sql": {
          "default": "",
          "description": "The single read statement to run. Leave empty when passing a cursor.",
          "type": "string"
        }
      },
      "type": "object"
    },
    "name": "pg_run_query",
    "output": {
      "$defs": {
        "Cell": {
