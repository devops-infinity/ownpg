  {
    "input": {
      "$defs": {
        "Toggle": {
          "enum": [
            "unset",
            "on",
            "off"
          ],
          "type": "string"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "clean": {
          "default": false,
          "description": "Drop the objects before recreating them; destructive.",
          "type": "boolean"
        },
        "confirm": {
          "default": false,
          "type": "boolean"
        },
        "data_only": {
          "default": false,
          "type": "boolean"
        },
        "dry_run": {
          "default": false,
          "type": "boolean"
        },
        "exit_on_error": {
          "$ref": "#/$defs/Toggle",
          "default": "unset",
          "description": "Stop at the first error instead of continuing past it (default true). A single transaction always stops at the first error."
        },
        "file": {
          "description": "Archive file or directory name inside output_dir.",
          "type": "string"
        },
        "if_exists": {
          "$ref": "#/$defs/Toggle",
          "default": "unset",
          "description": "With clean, skip objects that do not exist yet instead of failing; defaults to on whenever clean is on."
        },
        "jobs": {
          "default": "",
          "description": "Parallel jobs as text; empty keeps one.",
          "type": "string"
        },
        "no_owner": {
          "default": false,
          "type": "boolean"
        },
        "no_privileges": {
          "default": false,
          "type": "boolean"
        },
        "schema_only": {
          "default": false,
          "type": "boolean"
        },
        "single_transaction": {
          "$ref": "#/$defs/Toggle",
          "default": "unset",
          "description": "Restore inside one transaction, so a failure leaves the database untouched. Defaults to on when jobs and transaction_size are empty; parallel jobs cannot use it."
        },
        "tables": {
          "default": [],
          "description": "Tables to restore; empty restores everything in the scoped schema.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "timeout_seconds": {
          "default": 3600,
          "description": "Seconds before the program is killed (default 3600).",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "transaction_size": {
          "default": "",
          "description": "Commit every N objects as text (pg_restore 17 and later); lets a parallel or very large restore run in batches. Empty leaves it off.",
          "type": "string"
        }
      },
      "required": [
        "file"
      ],
      "type": "object"
    },
