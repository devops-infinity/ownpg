  {
    "name": "pg_insert",
    "title": "Insert rows",
    "description": "Insert one or more rows into a table of the scoped schema. Rows are JSON objects keyed by column name; values are converted to the column types by PostgreSQL. One statement inserts every row with the union of the columns the rows name: a column a row leaves out becomes NULL, and only a column no row names takes its default. on_conflict can ignore duplicates or update the listed columns. returning lists the columns to return (\"*\" for all). dry_run shows the statement without running it; transaction runs it inside an open handle.",
    "inputSchema": {
      "$defs": {
        "OnConflict": {
          "enum": [
            "error",
            "do_nothing",
            "update"
          ],
          "type": "string"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "conflict_columns": {
          "default": [],
          "description": "Conflict target columns for do_nothing and update.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "dry_run": {
          "default": false,
          "description": "Show the statement without running it.",
          "type": "boolean"
        },
        "on_conflict": {
          "$ref": "#/$defs/OnConflict",
          "default": "error",
          "description": "error (default), do_nothing, or update."
        },
        "returning": {
          "default": [],
          "description": "Columns to return, or [\"*\"] for every column. Empty returns nothing.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "rows": {
          "description": "Rows to insert, each a JSON object keyed by column name.",
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "type": "array"
        },
        "table": {
          "description": "Table name, optionally schema-qualified.",
          "type": "string"
        },
        "transaction": {
          "default": "",
          "description": "Run inside this transaction handle.",
          "type": "string"
        },
        "update_columns": {
          "default": [],
          "description": "Columns to overwrite on conflict when on_conflict is update. Default: every inserted column except the conflict columns.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "table",
        "rows"
      ],
      "type": "object"
    },
    "outputSchema": {
      "$defs": {
        "Column": {
          "properties": {
            "name": {
              "type": "string"
            },
            "type": {
              "type": "string"
            }
          },
          "required": [
            "name",
            "type"
          ],
          "type": "object"
        },
        "Truncation": {
          "enum": [
            "row_cap",
            "byte_cap",
            "cell_cap"
          ],
          "type": "string"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "cells_cut": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "columns": {
          "items": {
            "$ref": "#/$defs/Column"
          },
          "type": "array"
        },
        "cursor": {
          "type": [
            "string",
            "null"
          ]
        },
        "estimate": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "notice": {
          "type": "string"
        },
        "row_count": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "rows": {
          "items": {
            "items": {
              "type": [
                "string",
                "null"
              ]
            },
            "type": "array"
          },
          "type": "array"
        },
        "rows_affected": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "truncated": {
          "type": "boolean"
        },
        "truncated_by": {
          "anyOf": [
            {
              "$ref": "#/$defs/Truncation"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "columns",
        "rows",
        "row_count",
        "truncated",
        "cells_cut",
        "notice"
      ],
      "type": "object"
    },
    "annotations": {
      "title": "Insert rows",
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": false
    }
  },
  {
    "name": "pg_update",
    "title": "Update rows",
    "description": "Update rows of a table in the scoped schema. set is a JSON object of column values; filter is a SQL boolean expression placed after WHERE. An update without a filter, or with a filter that is always true, touches every row and needs confirm: true (or the confirmation prompt when the client supports it). returning lists columns to return; on PostgreSQL 18, returning_old_new adds the old and new row images.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "confirm": {
          "default": false,
          "description": "Run a statement that touches every row.",
          "type": "boolean"
        },
        "dry_run": {
          "default": false,
          "description": "Show the statement without running it.",
          "type": "boolean"
        },
        "filter": {
          "default": "",
          "description": "SQL boolean expression placed after WHERE. Empty means every row and needs confirmation.",
          "type": "string"
        },
        "returning": {
          "default": [],
          "description": "Columns to return, or [\"*\"] for every column.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "returning_old_new": {
          "default": false,
          "description": "PostgreSQL 18 and later: also return the old and new row images as JSON.",
          "type": "boolean"
        },
        "set": {
          "additionalProperties": true,
          "description": "Column values to set, as a JSON object.",
          "type": "object"
        },
        "table": {
          "description": "Table name, optionally schema-qualified.",
          "type": "string"
        },
        "transaction": {
          "default": "",
          "description": "Run inside this transaction handle.",
          "type": "string"
        }
      },
      "required": [
        "table",
        "set"
      ],
      "type": "object"
    },
    "outputSchema": {
      "$defs": {
        "Column": {
          "properties": {
            "name": {
              "type": "string"
            },
            "type": {
              "type": "string"
            }
          },
          "required": [
            "name",
            "type"
          ],
          "type": "object"
        },
        "Truncation": {
          "enum": [
            "row_cap",
            "byte_cap",
            "cell_cap"
          ],
          "type": "string"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "cells_cut": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "columns": {
          "items": {
            "$ref": "#/$defs/Column"
          },
          "type": "array"
        },
        "cursor": {
          "type": [
            "string",
            "null"
          ]
        },
        "estimate": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "notice": {
          "type": "string"
        },
        "row_count": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "rows": {
          "items": {
            "items": {
              "type": [
                "string",
                "null"
              ]
            },
            "type": "array"
          },
          "type": "array"
        },
        "rows_affected": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "truncated": {
          "type": "boolean"
        },
        "truncated_by": {
          "anyOf": [
            {
              "$ref": "#/$defs/Truncation"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "columns",
        "rows",
        "row_count",
        "truncated",
        "cells_cut",
        "notice"
      ],
      "type": "object"
    },
    "annotations": {
      "title": "Update rows",
      "readOnlyHint": false,
      "destructiveHint": true,
      "idempotentHint": false,
      "openWorldHint": false
    }
  },
