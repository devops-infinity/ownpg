---
source: crates/ownpg-core/src/tool_specs.rs
expression: tools
---
[
  {
    "name": "pg_list_objects",
    "title": "List objects in the scoped schema",
    "description": "List objects in the scoped schema: tables, views, materialized views, sequences, functions, procedures, types, indexes, extensions, and the schemas of the database. Filter by object type and by a LIKE pattern on the name (% and _ are wildcards). The list is sorted by schema, then name, then OID, so repeated calls return the same order. At most 200 objects return per call; when more remain, truncated is true and cursor carries a token to pass back for the next page.",
    "inputSchema": {
      "$defs": {
        "DetailLevel": {
          "enum": [
            "names",
            "summary"
          ],
          "type": "string"
        },
        "ObjectType": {
          "enum": [
            "schema",
            "table",
            "view",
            "materialized_view",
            "sequence",
            "function",
            "procedure",
            "type",
            "index",
            "extension"
          ],
          "type": "string"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "cursor": {
          "default": "",
          "description": "Cursor from a previous truncated result. Leave empty for the first page.",
          "type": "string"
        },
        "detail_level": {
          "$ref": "#/$defs/DetailLevel",
          "default": "summary",
          "description": "names returns schema, name, and kind only; wants_summary adds owner, comment, size, and row estimate."
        },
        "name_pattern": {
          "default": "%",
          "description": "LIKE pattern on the object name. Default: % (every name).",
          "type": "string"
        },
        "object_types": {
          "default": [],
          "description": "Object types to include. Empty means every type.",
          "items": {
            "$ref": "#/$defs/ObjectType"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "outputSchema": {
      "$defs": {
        "ObjectRow": {
          "properties": {
            "comment": {
              "type": [
                "string",
                "null"
              ]
            },
            "detail": {
              "type": [
                "string",
                "null"
              ]
            },
            "estimated_rows": {
              "format": "int64",
              "type": [
                "integer",
                "null"
              ]
            },
            "kind": {
              "$ref": "#/$defs/ObjectType"
            },
            "name": {
              "type": "string"
            },
            "oid": {
              "format": "int64",
              "type": "integer"
            },
            "owner": {
              "type": [
                "string",
                "null"
              ]
            },
            "schema": {
              "type": "string"
            },
            "size_bytes": {
              "format": "int64",
              "type": [
                "integer",
                "null"
              ]
            }
          },
          "required": [
            "schema",
            "name",
            "kind",
            "oid"
          ],
          "type": "object"
        },
        "ObjectType": {
          "enum": [
            "schema",
            "table",
            "view",
            "materialized_view",
            "sequence",
            "function",
            "procedure",
            "type",
            "index",
            "extension"
          ],
          "type": "string"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "cursor": {
          "type": [
            "string",
            "null"
          ]
        },
        "estimate": {
          "format": "int64",
          "type": "integer"
        },
        "notice": {
          "type": "string"
        },
        "order": {
          "type": "string"
        },
        "row_count": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "rows": {
          "items": {
            "$ref": "#/$defs/ObjectRow"
          },
          "type": "array"
        },
        "schema": {
          "type": "string"
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "required": [
        "schema",
        "rows",
        "row_count",
        "truncated",
        "estimate",
        "order",
        "notice"
      ],
      "type": "object"
    },
    "annotations": {
      "title": "List objects in the scoped schema",
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "pg_describe",
    "title": "Describe one database object",
    "description": "Describe one object in detail. For a table, view, or materialized view: columns with types, defaults, identity and generated markers, constraints with validity, indexes with validity and size, triggers, row-level security policies, comments, size, and the estimated row count. Also describes sequences, functions and procedures (every overload), types (enum labels, composite attributes, domain constraints), extensions, roles, and the privileges granted on a relation. Names may be schema-qualified; unqualified names resolve in the scoped schema.",
    "inputSchema": {
      "$defs": {
        "DescribeTarget": {
          "enum": [
            "auto",
            "relation",
            "routine",
            "type",
            "extension",
            "role",
            "privileges"
          ],
          "type": "string"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "name": {
          "description": "Object name, optionally schema-qualified (schema.name). Quote mixed-case names with double quotes.",
          "type": "string"
        },
        "target": {
          "$ref": "#/$defs/DescribeTarget",
          "default": "auto",
          "description": "What the name refers to. auto tries a relation, then a routine, then a type, then an extension."
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "outputSchema": {
